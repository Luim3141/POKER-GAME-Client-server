<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.poker.ui.MainController"
            stylesheets="@poker.css" styleClass="app-root">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="topbar">
            <padding><Insets top="13" right="22" bottom="13" left="22"/></padding>
            <VBox spacing="-3">
                <Label text="RIVER" styleClass="brand-name"/>
                <Label text="POKER ROOM" styleClass="brand-subtitle"/>
            </VBox>
            <FlowPane alignment="CENTER_RIGHT" hgap="2" vgap="4" minWidth="0" HBox.hgrow="ALWAYS">
                <Button fx:id="homeNavButton" text="Trang chủ" onAction="#goHome" visible="false" managed="false" styleClass="text-button"/>
                <Button fx:id="historyNavButton" text="Lịch sử" onAction="#showHistory" visible="false" managed="false" styleClass="text-button"/>
                <Button fx:id="walletNavButton" text="Ví coin" onAction="#showWallet" visible="false" managed="false" styleClass="text-button"/>
                <Button fx:id="adminNavButton" text="Quản trị" onAction="#showAdmin" visible="false" managed="false" styleClass="text-button"/>
            </FlowPane>
            <MenuButton fx:id="displayMenu" text="Hiển thị" accessibleText="Chọn kích thước cửa sổ hoặc toàn màn hình" styleClass="ghost-button"/>
            <VBox alignment="CENTER_RIGHT" spacing="1">
                <Label fx:id="userLabel" text="Khách" styleClass="user-name"/>
                <Label fx:id="walletLabel" text="0 chips" styleClass="wallet-label"/>
            </VBox>
            <Label fx:id="statusLabel" text="Chưa kết nối" minWidth="100" maxWidth="160" styleClass="status-pill"/>
            <Button fx:id="logoutButton" text="Đăng xuất" onAction="#logout" visible="false" managed="false" styleClass="ghost-button"/>
        </HBox>
    </top>

    <center>
        <StackPane fx:id="pageHost" snapToPixel="false">
            <HBox fx:id="loginPage" alignment="CENTER" fillHeight="false" spacing="64" styleClass="auth-page">
                <VBox maxWidth="410" spacing="22">
                    <Label text="NO LIMIT TEXAS HOLD'EM" styleClass="hero-kicker"/>
                    <Label text="Một bàn bài.&#10;Những người bạn." wrapText="true" styleClass="hero-title"/>
                    <Label text="Vào sảnh, chọn bàn và sẵn sàng.&#10;Chơi Texas Hold’em cùng bạn bè trên mạng riêng." wrapText="true" styleClass="hero-copy"/>
                    <HBox spacing="18">
                        <VBox><Label text="10,000" styleClass="hero-stat"/><Label text="CHIP KHỞI ĐẦU" styleClass="metric-caption"/></VBox>
                        <VBox><Label text="20s" styleClass="hero-stat"/><Label text="MỖI LƯỢT" styleClass="metric-caption"/></VBox>
                        <VBox><Label text="2–8" styleClass="hero-stat"/><Label text="NGƯỜI / BÀN" styleClass="metric-caption"/></VBox>
                    </HBox>
                </VBox>
                <VBox prefWidth="420" maxWidth="420" spacing="15" styleClass="auth-card">
                    <Label text="Chào mừng trở lại" styleClass="page-title"/>
                    <Label text="Đăng nhập hoặc tạo tài khoản để vào sảnh" styleClass="page-subtitle"/>
                    <Label text="TÀI KHOẢN" styleClass="section-kicker"/>
                    <TextField fx:id="usernameField" promptText="Tên người chơi" accessibleText="Username"/>
                    <PasswordField fx:id="passwordField" promptText="Mật khẩu" accessibleText="Password"/>
                    <HBox spacing="9">
                        <Button fx:id="loginButton" text="Đăng nhập" onAction="#login" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="primary-button"/>
                        <Button fx:id="registerButton" text="Đăng ký" onAction="#register" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="ghost-button"/>
                    </HBox>
                    <Separator/>
                    <Label text="MÁY CHỦ" styleClass="section-kicker"/>
                    <HBox spacing="8">
                        <TextField fx:id="hostField" text="127.0.0.1" promptText="Host" HBox.hgrow="ALWAYS" accessibleText="Server host"/>
                        <TextField fx:id="portField" text="19090" promptText="Port" prefWidth="76" accessibleText="Server port"/>
                    </HBox>
                    <Label text="Ứng dụng tự kết nối. Đổi địa chỉ nếu server chuyển IP." styleClass="form-hint"/>
                    <Label text="Chips dùng trong game, không có giá trị tiền thật." wrapText="true" styleClass="form-hint"/>
                </VBox>
            </HBox>

            <BorderPane fx:id="homePage" visible="false" managed="false" styleClass="content-pane">
                <top>
                    <VBox spacing="14">
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="3">
                                <Label text="Sảnh Poker" styleClass="page-title"/>
                                <Label text="Chọn bàn phù hợp hoặc tạo một bàn mới" styleClass="page-subtitle"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="↻  Làm mới" onAction="#lobby" styleClass="ghost-button"/>
                        </HBox>
                        <HBox fx:id="createTableBar" spacing="10" alignment="CENTER_LEFT" styleClass="toolbar-card">
                            <Label text="Tạo bàn mới" styleClass="toolbar-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Small blind" styleClass="field-label"/>
                            <TextField fx:id="smallBlindField" text="100" prefWidth="88" accessibleText="Small blind"/>
                            <Label text="Số ghế" styleClass="field-label"/>
                            <TextField fx:id="seatsField" text="8" prefWidth="58" accessibleText="Số ghế, từ 2 đến 8"/>
                            <Button text="Tạo bàn" onAction="#createTable" styleClass="accent-button"/>
                        </HBox>
                    </VBox>
                </top>
                <center>
                    <HBox spacing="16">
                        <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="panel">
                            <Label text="BÀN ĐANG MỞ" styleClass="section-kicker"/>
                            <ScrollPane fitToWidth="true" HbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="clean-scroll">
                                <content><VBox fx:id="tablesList" spacing="10"/></content>
                            </ScrollPane>
                        </VBox>
                        <VBox prefWidth="300" spacing="16">
                            <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="panel">
                                <Label text="ĐANG ONLINE" styleClass="section-kicker"/>
                                <ScrollPane fitToWidth="true" HbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="clean-scroll">
                                    <content><VBox fx:id="onlineList" spacing="8"/></content>
                                </ScrollPane>
                            </VBox>
                            <VBox spacing="10" VBox.vgrow="ALWAYS" styleClass="panel">
                                <Label text="BẢNG XẾP HẠNG" styleClass="section-kicker"/>
                                <ScrollPane fitToWidth="true" HbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="clean-scroll">
                                    <content><VBox fx:id="rankingList" spacing="8"/></content>
                                </ScrollPane>
                            </VBox>
                        </VBox>
                    </HBox>
                </center>
                <bottom>
                    <HBox fx:id="joinBar" spacing="10" alignment="CENTER_LEFT" styleClass="join-bar">
                        <Label text="Mã bàn" styleClass="field-label"/>
                        <TextField fx:id="tableIdField" promptText="Nhập hoặc chọn mã bàn" HBox.hgrow="ALWAYS" accessibleText="Table identifier"/>
                        <Button text="Vào chơi" onAction="#joinTable" styleClass="primary-button"/>
                        <Button text="Chấp nhận lời mời" onAction="#acceptInvite" styleClass="text-button"/>
                    </HBox>
                </bottom>
            </BorderPane>

            <BorderPane fx:id="tablePage" visible="false" managed="false" styleClass="content-pane">
                <top>
                    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="game-header">
                        <Button text="←  Về sảnh" onAction="#backToLobby" styleClass="ghost-button"/>
                        <VBox spacing="2">
                            <Label fx:id="tableTitleLabel" text="Bàn Poker" styleClass="page-title"/>
                            <HBox spacing="8">
                                <Label fx:id="tableStatusLabel" text="ĐANG CHỜ" styleClass="mini-pill"/>
                                <Label fx:id="roleLabel" text="PLAYER" styleClass="mini-pill"/>
                                <Label fx:id="playersCountLabel" text="0 / 0 người chơi" styleClass="muted-label"/>
                            </HBox>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <HBox fx:id="inviteBox" spacing="7" alignment="CENTER_LEFT">
                            <TextField fx:id="inviteUserField" promptText="Mời username" prefWidth="150" accessibleText="Username to invite"/>
                            <Button text="Mời vào bàn" onAction="#invite" styleClass="ghost-button"/>
                        </HBox>
                        <VBox alignment="CENTER_RIGHT" spacing="1">
                            <Label text="BLINDS" styleClass="metric-caption"/>
                            <Label fx:id="blindsLabel" text="— / —" styleClass="metric-value"/>
                        </VBox>
                    </HBox>
                </top>
                <center>
                    <StackPane minHeight="400" styleClass="table-shell">
                        <Region maxWidth="1100" maxHeight="660" styleClass="table-rail"/>
                        <Pane fx:id="tableCanvas" prefWidth="1100" prefHeight="600" maxWidth="1100" maxHeight="660">
                            <VBox fx:id="centerBoard" managed="false" alignment="CENTER" spacing="8" prefWidth="390">
                                <HBox alignment="CENTER" spacing="8">
                                    <Label fx:id="streetLabel" text="CHỜ VÁN MỚI" styleClass="street-label"/>
                                    <Label fx:id="timerLabel" text="" styleClass="timer-label"/>
                                </HBox>
                                <HBox fx:id="boardCards" alignment="CENTER" spacing="8"/>
                                <Label fx:id="totalPotLabel" text="TỔNG POT  0" styleClass="total-pot"/>
                            </VBox>
                        </Pane>
                    </StackPane>
                </center>
                <bottom>
                    <VBox spacing="4" styleClass="action-tray">
                        <Label fx:id="resultBannerLabel" text="" wrapText="true" maxWidth="Infinity" visible="false" managed="false" styleClass="result-banner"/>
                        <FlowPane fx:id="potsRow" alignment="CENTER_LEFT" hgap="6" vgap="4" prefWrapLength="1040"/>
                        <FlowPane fx:id="actionsRow" alignment="CENTER_LEFT" hgap="8" vgap="3" prefWrapLength="1040" accessibleText="Sáu hành động gần nhất tại bàn"/>
                        <HBox alignment="CENTER_LEFT" spacing="12" fillHeight="false">
                            <VBox spacing="4" minWidth="0" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label fx:id="actionInfoLabel" text="Chờ ván mới" wrapText="true" styleClass="action-info"/>
                                    <Label fx:id="turnHintLabel" text="Nhấn Sẵn sàng để bắt đầu" minWidth="0" maxWidth="Infinity" HBox.hgrow="ALWAYS" wrapText="true" styleClass="turn-hint"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Button fx:id="readyButton" text="Sẵn sàng" onAction="#ready" styleClass="accent-button"/>
                                    <Button text="Rời bàn" onAction="#backToLobby" styleClass="text-button"/>
                                </HBox>
                            </VBox>
                            <VBox fx:id="bettingBox" spacing="3" alignment="CENTER_RIGHT">
                            <HBox fx:id="wagerBox" alignment="CENTER_RIGHT" spacing="8">
                                <Label fx:id="amountLabel" text="Raise to — tổng cược trong vòng" styleClass="field-label"/>
                                <VBox prefWidth="220" maxWidth="220" minWidth="160" spacing="6" alignment="CENTER_RIGHT">
                                    <Slider fx:id="wagerSlider" min="0" max="1000" blockIncrement="10" majorTickUnit="100" minorTickCount="0" maxWidth="220" accessibleText="Kéo hoặc dùng phím mũi tên chọn mức cược"/>
                                    <TextField fx:id="betAmountField" text="200" maxWidth="220" accessibleText="Nhập chính xác tổng mức Bet hoặc Raise to"/>
                                </VBox>
                            </HBox>
                            <Label fx:id="wagerHintLabel" text="" wrapText="true" maxWidth="420" styleClass="turn-hint"/>
                            <HBox alignment="CENTER_RIGHT" spacing="6">
                                <Button fx:id="foldButton" text="Fold" onAction="#fold" styleClass="danger-button"/>
                                <Button fx:id="checkButton" text="Check" onAction="#check" styleClass="ghost-button"/>
                                <Button fx:id="callButton" text="Call" onAction="#call" styleClass="primary-button"/>
                                <Button fx:id="betButton" text="Bet" onAction="#bet" styleClass="primary-button"/>
                                <Button fx:id="raiseButton" text="Raise" onAction="#raise" styleClass="primary-button"/>
                                <Button fx:id="allInButton" text="All-in" onAction="#allIn" styleClass="allin-button"/>
                            </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </bottom>
            </BorderPane>

            <VBox fx:id="historyPage" visible="false" managed="false" spacing="16" styleClass="content-pane">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Button text="←  Quay lại" onAction="#backToContext" styleClass="ghost-button"/>
                    <VBox spacing="3">
                        <Label text="Lịch sử ván đấu" styleClass="page-title"/>
                        <Label text="Kết quả và biến động chip gần nhất" styleClass="page-subtitle"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="↻  Tải lại" onAction="#history" styleClass="ghost-button"/>
                </HBox>
                <ScrollPane fitToWidth="true" HbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="clean-scroll">
                    <content><VBox fx:id="historyList" spacing="10"/></content>
                </ScrollPane>
            </VBox>

            <VBox fx:id="coinPage" visible="false" managed="false" spacing="16" styleClass="content-pane">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Button text="←  Quay lại" onAction="#backToContext" styleClass="ghost-button"/>
                    <VBox><Label text="Ví coin" styleClass="page-title"/><Label text="Gửi yêu cầu và theo dõi trạng thái duyệt" styleClass="page-subtitle"/></VBox>
                </HBox>
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="toolbar-card">
                    <Label text="Số coin" styleClass="field-label"/>
                    <TextField fx:id="coinAmountField" text="10000" prefWidth="130"/>
                    <Button fx:id="coinSubmitButton" text="Gửi yêu cầu" onAction="#submitCoinRequest" styleClass="accent-button"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="↻ Làm mới" onAction="#loadCoinRequests" styleClass="ghost-button"/>
                </HBox>
                <Label text="Mỗi lần chỉ có một yêu cầu đang chờ. Admin có thể duyệt coin sau khi bạn đã rời bàn." wrapText="true" styleClass="page-subtitle"/>
                <ScrollPane fitToWidth="true" HbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="clean-scroll">
                    <content><VBox fx:id="coinRequestsList" spacing="10"/></content>
                </ScrollPane>
            </VBox>

            <VBox fx:id="adminPage" visible="false" managed="false" spacing="16" styleClass="content-pane">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox><Label text="Admin Control Center" styleClass="page-title"/><Label text="Coin requests và quản trị tài khoản theo thời gian thực" styleClass="page-subtitle"/></VBox>
                    <Region HBox.hgrow="ALWAYS"/><TextField fx:id="adminSearchField" promptText="Tìm tài khoản" prefWidth="220"/><Button text="↻ Làm mới" onAction="#loadAdminDashboard" styleClass="ghost-button"/>
                </HBox>
                <SplitPane dividerPositions="0.46" VBox.vgrow="ALWAYS">
                    <VBox spacing="10" styleClass="panel">
                        <Label text="YÊU CẦU COIN" styleClass="section-kicker"/>
                        <ScrollPane fitToWidth="true" HbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="clean-scroll"><content><VBox fx:id="adminRequestsList" spacing="9"/></content></ScrollPane>
                    </VBox>
                    <VBox spacing="10" styleClass="panel">
                        <Label text="TÀI KHOẢN" styleClass="section-kicker"/>
                        <ScrollPane fitToWidth="true" HbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="clean-scroll"><content><VBox fx:id="adminUsersList" spacing="9"/></content></ScrollPane>
                    </VBox>
                </SplitPane>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
